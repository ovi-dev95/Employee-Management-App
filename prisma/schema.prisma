generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String
  role               String       @default("SUBSCRIBER")
  position           String?
  department         String       @default("WEB")
  points             Int          @default(0)
  avatar             String?
  cover              String?
  location           String?
  emailNotifications Boolean      @default(true)
  pushNotifications  Boolean      @default(true)
  twoFactorEnabled   Boolean      @default(false)
  
  // Invitation System
  inviteToken        String?      @unique
  inviteTokenExpiry  DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  activities         Activity[]
  attendance         Attendance[]
  ideas              Idea[]
  booked             Meeting[]    @relation("Attendee")
  meetings           Meeting[]    @relation("Host")
  requests           Request[]
  votes              Vote[]
  sopLikes           SOPLike[]
  sopDislikes        SOPDislike[]
  ideaDislikes       IdeaDislike[]
  comments           Comment[]
}

model SystemSettings {
  id               String   @id @default("global")
  lookerStudioUrl  String?
  checkInTime      String   @default("12:00 PM")
  checkOutTime     String   @default("08:00 PM")
  sickLeaveDays    Int      @default(10)
  paidLeaveDays    Int      @default(15)
  yearlyLeaveDays  Int      @default(20)
  yearlyLeaveDates String?
  // Email Settings
  emailProvider    String   @default("smtp") // "smtp", "brevo", "resend"
  brevoApiKey      String?
  resendApiKey     String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassword     String?
  smtpFromEmail    String?
  pointValues      String?  @default("{\"login\":1,\"idea\":10,\"request\":5,\"sop\":20,\"checkIn\":1,\"checkOut\":1}")

  updatedAt        DateTime @updatedAt
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  date      DateTime  @default(now())
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  duration  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model Request {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  submittedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [submittedBy], references: [id])
}

model SOP {
  id        String   @id @default(uuid())
  title     String
  category  String
  videoUrl     String?
  docUrl       String?
  featureImage String?
  content      String
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     SOPLike[]
  dislikes  SOPDislike[]
  comments  Comment[]
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("REVIEW")
  upvotes     Int      @default(0)
  submittedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [submittedBy], references: [id])
  votes       Vote[]
  dislikes    IdeaDislike[]
  comments    Comment[]
}

model Vote {
  id     String @id @default(uuid())
  userId String
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, ideaId])
}

model SOPLike {
  id        String   @id @default(uuid())
  userId    String
  sopId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  sop       SOP      @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([userId, sopId])
}

model SOPDislike {
  id        String   @id @default(uuid())
  userId    String
  sopId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  sop       SOP      @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([userId, sopId])
}

model IdeaDislike {
  id        String   @id @default(uuid())
  userId    String
  ideaId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  sopId     String?
  sop       SOP?     @relation(fields: [sopId], references: [id], onDelete: Cascade)
  
  ideaId    String?
  idea      Idea?    @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id         String   @id @default(uuid())
  title      String
  type       String
  startTime  DateTime
  endTime    DateTime
  notes      String?
  hostId     String
  attendeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  attendee   User?    @relation("Attendee", fields: [attendeeId], references: [id])
  host       User     @relation("Host", fields: [hostId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  action    String
  points    Int
  category  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model RM_Employee_Management_Tool {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("RM Employee Management Tool")
}
